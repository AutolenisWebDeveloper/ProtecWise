# /home/protecwise/proxy/.env  (copy to .env on the proxy host — NEVER commit .env)

# CompuLife Authorization ID — injected into every request server-side.
# Development (500 lifetime requests): 66b12312b
# Production: obtain from CompuLife and register it to IP 34.16.56.64.
COMPULIFE_AUTH_ID=

# Must match PROXY_SECRET in the Next.js / Vercel environment. Generate with:
#   openssl rand -hex 32
PROXY_SECRET=

PORT=3001
